{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcm-safe-knowledge-qa/semantic-signals.schema.json",
  "title": "Framework-Neutral Semantic Signals",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguity": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_gap": {"type": "number", "minimum": 0, "maximum": 1},
    "load_level": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["dosage", "toxicity", "pregnancy", "child", "elderly", "liver_kidney_impairment", "allergy", "drug_interaction", "treatment_change"]
      }
    },
    "permission_ok": {"type": "boolean"},
    "emergency": {"type": "boolean"},
    "medical_personalization": {"type": "boolean"},
    "missing_decisive_facts": {"type": "boolean"},
    "requires_fresh_data": {"type": "boolean"},
    "requires_exact_value": {"type": "boolean"},
    "multi_hop": {"type": "boolean"},
    "use_history": {"type": "boolean"},
    "write_requested": {"type": "boolean"}
  }
}
