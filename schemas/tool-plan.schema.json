{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tcm-safe-knowledge-qa/tool-plan.schema.json",
  "title": "Validated Tool Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool_family", "purpose", "side_effect", "arguments", "confidence", "tenant_id", "expected_output_fields"],
  "properties": {
    "tool_family": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "side_effect": {"enum": ["none", "read", "write"]},
    "arguments": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "expected_output_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "idempotency_key": {"type": ["string", "null"]},
    "requires_confirmation": {"type": "boolean"},
    "trace_id": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"side_effect": {"const": "write"}}},
      "then": {
        "required": ["idempotency_key", "requires_confirmation"],
        "properties": {
          "idempotency_key": {"type": "string", "minLength": 8},
          "requires_confirmation": {"const": true}
        }
      }
    }
  ]
}
